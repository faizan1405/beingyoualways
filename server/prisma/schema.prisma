// Being You – Always — production database (Hostinger MySQL / MariaDB).
// Money is stored as DECIMAL(10,2) in INR. Ids of migrated catalogue rows keep the
// ids the storefront already uses (e.g. "bya-1069") so existing links keep working.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Admin users, roles, sessions ─────────────────────────

model User {
  id                String               @id @default(cuid())
  email             String               @unique @db.VarChar(191)
  name              String               @db.VarChar(120)
  passwordHash      String               @db.VarChar(255)
  isActive          Boolean              @default(true)
  failedLoginCount  Int                  @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime             @default(now())
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  roles             UserRole[]
  sessions          Session[]
  resetTokens       PasswordResetToken[]
  activity          AdminActivityLog[]
}

model Role {
  id          Int              @id @default(autoincrement())
  key         String           @unique @db.VarChar(40)
  name        String           @db.VarChar(80)
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique @db.VarChar(80)
  description String           @db.VarChar(255)
  roles       RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId String
  roleId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

/// Server-side admin sessions. Only a SHA-256 hash of the cookie token is stored.
model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique @db.Char(64)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?   @db.VarChar(64)
  userAgent  String?   @db.VarChar(255)

  @@index([userId])
  @@index([expiresAt])
}

/// Account-recovery groundwork (single-use, hashed, short-lived). Delivery by email is a later phase.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @db.Char(64)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ───────────────────────────────── Catalogue ─────────────────────────────────

model Category {
  id          Int       @id @default(autoincrement())
  slug        String    @unique @db.VarChar(80)
  name        String    @db.VarChar(120)
  tagline     String    @db.VarChar(200)
  description String    @db.Text
  position    Int       @default(0)
  products    Product[]
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum VariantKind {
  SIZE
  SHADE
}

model Product {
  id               String           @id @db.VarChar(64)
  slug             String           @unique @db.VarChar(191)
  name             String           @db.VarChar(200)
  categoryId       Int
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  collection       String?          @db.VarChar(120)
  shortDescription String           @db.Text
  description      String           @db.Text
  directions       String           @db.Text
  /// string[] — full ingredient list, only as printed on the pack
  ingredients      Json
  /// string[] | null — hero ingredients named by the brand
  keyIngredients   Json?
  /// { label, value }[]
  details          Json
  /// string[] | null
  benefits         Json?
  /// string[] | null — admin-set concern tags (null = storefront default mapping)
  concerns         Json?
  /// string[] | null — hand-picked related product slugs
  relatedSlugs     Json?
  shape            String           @db.VarChar(20)
  tint             String           @db.VarChar(60)
  featured         Boolean          @default(false)
  bestSeller       Boolean          @default(false)
  status           ProductStatus    @default(DRAFT)
  isSample         Boolean          @default(false)
  /// catalogue order (lower first)
  sortOrder        Int              @default(0)
  sourceUrl        String?          @db.VarChar(500)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  archivedAt       DateTime?
  variants         ProductVariant[]
  images           ProductImage[]
  media            MediaAsset[]
  orderItems       OrderItem[]
  reviews          Review[]

  @@index([status, sortOrder])
  @@index([categoryId])
}

/// A size or shade. Prices are INR.
model ProductVariant {
  id             String      @id @db.VarChar(64)
  productId      String      @db.VarChar(64)
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  label          String      @db.VarChar(120)
  kind           VariantKind
  price          Decimal     @db.Decimal(10, 2)
  compareAtPrice Decimal?    @db.Decimal(10, 2)
  swatch         String?     @db.VarChar(60)
  position       Int         @default(0)
  inventory      Inventory?
  orderItems     OrderItem[]

  @@index([productId])
}

/// quantity = counted units on hand; null = not counted yet, so it cannot be ordered.
/// reserved = units held by unpaid online-payment orders (released on failure/expiry).
/// Orderable = quantity - reserved.
model Inventory {
  variantId String         @id @db.VarChar(64)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int?
  reserved  Int            @default(0)
  updatedAt DateTime       @updatedAt
}

/// url is either "asset:<path under src/assets>" (bundled catalogue photo) or an https URL (Hostinger media).
model ProductImage {
  id        String  @id @default(cuid())
  productId String  @db.VarChar(64)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String  @db.VarChar(1024)
  alt       String? @db.VarChar(300)
  position  Int     @default(0)

  @@index([productId, position])
}

// ─────────────────────── Customers, orders, payments ───────────────────────

enum CustomerStatus {
  ACTIVE
  BLOCKED
}

model Customer {
  id                String            @id @default(cuid())
  name              String            @db.VarChar(120)
  email             String?           @unique @db.VarChar(191)
  phone             String?           @unique @db.VarChar(20)
  status            CustomerStatus    @default(ACTIVE)
  signInMethod      String?           @db.VarChar(20)
  googleSub         String?           @unique @db.VarChar(64)
  /// Argon2id hash — null for accounts that have never set a password (Google-only or guest-created).
  passwordHash      String?           @db.VarChar(255)
  /// Set when the customer confirms the link sent to their address.
  emailVerifiedAt   DateTime?
  /// Set when the customer proves the number with a WhatsApp sign-in code.
  phoneVerifiedAt   DateTime?
  failedLoginCount  Int               @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  /// Sessions opened before this moment are refused (sign-out everywhere on password change).
  passwordChangedAt DateTime          @default(now())
  /// Personal-data removal: the row is anonymised and this is set; nothing is hard-deleted by the site.
  deletedAt         DateTime?
  notes             String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  addresses         ShippingAddress[]
  orders            Order[]
  reviews           Review[]
  whatsappConsents  WhatsAppConsent[]
  sessions          CustomerSession[]
  tokens            CustomerToken[]

  @@index([deletedAt])
}

/// Server-side customer sessions. Only a SHA-256 hash of the cookie token is stored.
/// Separate from admin sessions: a customer cookie can never reach the admin checks.
model CustomerSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique @db.Char(64)
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?   @db.VarChar(64)
  userAgent  String?   @db.VarChar(255)

  @@index([customerId])
  @@index([expiresAt])
}

enum CustomerTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  LINK_GOOGLE
}

/// Single-use, hashed, short-lived tokens for email verification, password recovery and Google linking.
model CustomerToken {
  id         String               @id @default(cuid())
  tokenHash  String               @unique @db.Char(64)
  customerId String
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  purpose    CustomerTokenPurpose
  /// the address the token applies to (verification / change)
  target     String?              @db.VarChar(191)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime             @default(now())

  @@index([customerId, purpose])
  @@index([expiresAt])
}

model ShippingAddress {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  label      String    @db.VarChar(40)
  name       String    @db.VarChar(120)
  phone      String    @db.VarChar(20)
  line1      String    @db.VarChar(255)
  line2      String?   @db.VarChar(255)
  city       String    @db.VarChar(100)
  state      String    @db.VarChar(100)
  pincode    String    @db.VarChar(10)
  isDefault  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  orders     Order[]

  @@index([customerId])
}

enum OrderStatus {
  /// online payment not completed yet (stock reserved, not committed)
  PENDING_PAYMENT
  NEW
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum OrderPaymentStatus {
  /// online payment started but not verified yet
  PENDING
  /// cash on delivery, not collected yet
  COD_PENDING
  /// verified provider payment or audited cash collection
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum StockState {
  NONE
  /// held for an unpaid online payment
  RESERVED
  /// deducted from stock
  COMMITTED
  /// reservation released (payment failed / expired / cancelled before payment)
  RELEASED
  /// deducted stock put back (qualifying cancellation / return)
  RESTORED
}

/// Money columns are INR rupees with 2 decimals; every calculation is done in integer paise on the server.
model Order {
  id                   String             @id @default(cuid())
  orderNumber          String             @unique @db.VarChar(30)
  customerId           String?
  customer             Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName         String             @default("") @db.VarChar(120)
  email                String?            @db.VarChar(191)
  phone                String?            @db.VarChar(20)
  status               OrderStatus        @default(NEW)
  paymentMethod        PaymentMethod      @default(COD)
  paymentStatus        OrderPaymentStatus @default(PENDING)
  subtotal             Decimal            @db.Decimal(10, 2)
  discountTotal        Decimal            @default(0) @db.Decimal(10, 2)
  /// null only on rows from before shipping was configured
  shippingTotal        Decimal?           @db.Decimal(10, 2)
  codFee               Decimal            @default(0) @db.Decimal(10, 2)
  grandTotal           Decimal            @db.Decimal(10, 2)
  currency             String             @default("INR") @db.Char(3)
  discountId           String?
  discount             Discount?          @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountCode         String?            @db.VarChar(40)
  shippingAddressId    String?
  shippingAddress      ShippingAddress?   @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  /// address as it was when the order was placed
  shippingSnapshot     Json
  notes                Json?
  stockState           StockState         @default(NONE)
  reservationExpiresAt DateTime?
  /// browser-generated idempotency key: the same checkout submitted twice returns the same order
  checkoutKey          String?            @unique @db.VarChar(64)
  /// SHA-256 of the priced lines, so a reused checkout key with a different bag is refused
  cartHash             String?            @db.Char(64)
  /// placed while Razorpay test keys were configured — never counted as sales
  isTest               Boolean            @default(false)
  paidAt               DateTime?
  carrier              String?            @db.VarChar(80)
  trackingNumber       String?            @db.VarChar(80)
  trackingUrl          String?            @db.VarChar(500)
  shippedAt            DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  cancelReason         String?            @db.VarChar(300)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  items                OrderItem[]
  payments             Payment[]
  events               OrderEvent[]
  paymentEvents        PaymentEvent[]

  @@index([customerId])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([createdAt])
}

/// Order timeline (system events, status changes, staff notes).
model OrderEvent {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// created | status | payment | note | shipment | stock | cancel | cod_collected
  type        String   @db.VarChar(30)
  message     String   @db.VarChar(500)
  actorUserId String?
  /// staff note text lives here (internal only)
  note        String?  @db.Text
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?         @db.VarChar(64)
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId    String?         @db.VarChar(64)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName  String          @db.VarChar(200)
  variantLabel String          @db.VarChar(120)
  unitPrice    Decimal         @db.Decimal(10, 2)
  quantity     Int
  lineTotal    Decimal         @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

/// A payment is only PAID after verified Razorpay data (checkout signature + fetched payment, or a signed
/// webhook) — or, for COD, an audited cash-collection entry by a permitted admin.
model Payment {
  id                  String         @id @default(cuid())
  orderId             String
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method              PaymentMethod
  status              PaymentStatus  @default(PENDING)
  amount              Decimal        @db.Decimal(10, 2)
  currency            String         @default("INR") @db.Char(3)
  providerOrderId     String?        @unique @db.VarChar(100)
  providerPaymentId   String?        @unique @db.VarChar(100)
  /// e.g. upi, card, netbanking (from Razorpay); never card numbers
  providerMethod      String?        @db.VarChar(30)
  signatureVerifiedAt DateTime?
  capturedAt          DateTime?
  failureReason       String?        @db.VarChar(255)
  isTest              Boolean        @default(false)
  /// manual COD collection: who recorded it and their reference
  recordedById        String?
  reference           String?        @db.VarChar(120)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  events              PaymentEvent[]

  @@index([orderId])
}

/// Every payment signal received (webhooks, checkout callbacks, reconciliation). eventId is unique,
/// so a webhook delivered twice is stored and processed once.
model PaymentEvent {
  id                String   @id @default(cuid())
  provider          String   @db.VarChar(20)
  eventId           String   @unique @db.VarChar(120)
  eventType         String   @db.VarChar(60)
  /// webhook | checkout | reconcile | admin
  source            String   @db.VarChar(20)
  signatureValid    Boolean
  orderId           String?
  order             Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentId         String?
  payment           Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  providerOrderId   String?  @db.VarChar(100)
  providerPaymentId String?  @db.VarChar(100)
  amountPaise       Int?
  /// what the server did: applied | ignored_duplicate | ignored_stale | rejected_mismatch | recorded
  outcome           String   @db.VarChar(40)
  detail            String?  @db.VarChar(500)
  createdAt         DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([providerOrderId])
}

enum DiscountType {
  PERCENT
  FIXED
}

model Discount {
  id            String       @id @default(cuid())
  code          String       @unique @db.VarChar(40)
  type          DiscountType
  value         Decimal      @db.Decimal(10, 2)
  minOrder      Decimal?     @db.Decimal(10, 2)
  maxDiscount   Decimal?     @db.Decimal(10, 2)
  startsAt      DateTime?
  endsAt        DateTime?
  usageLimit    Int?
  /// counts placed orders; given back if an unpaid order is cancelled or expires
  usedCount     Int          @default(0)
  active        Boolean      @default(false)
  description   String?      @db.VarChar(200)
  /// string[] | null — product ids the code applies to (null = all)
  productIds    Json?
  /// string[] | null — category slugs the code applies to (null = all)
  categorySlugs Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  orders        Order[]
}

// ─────────────────────────── Reviews & consent ───────────────────────────

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

/// Shown publicly only when verified + consented + published.
model Review {
  id               String       @id @default(cuid())
  customerId       String?
  customer         Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  productId        String?      @db.VarChar(64)
  product          Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  mediaAssets      MediaAsset[]
  authorName       String       @db.VarChar(120)
  rating           Int?
  body             String       @db.Text
  verifiedPurchase Boolean      @default(false)
  consentGiven     Boolean      @default(false)
  consentAt        DateTime?
  status           ReviewStatus @default(PENDING)
  /// [{ type: "photo"|"video", url, mediaId?, role?: "before"|"after"|"poster" }]
  media            Json?
  /// "Skin" | "Hair" | "Pigmentation" | "De-Tan" | "General Experience" (admin-set)
  category         String?      @db.VarChar(40)
  city             String?      @db.VarChar(100)
  /// string[] | null — where it may appear: "home" | "explore"
  placements       Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([productId, status])
  @@index([status, verifiedPurchase, consentGiven])
}

enum ConsentStatus {
  OPTED_IN
  OPTED_OUT
}

/// Append-only WhatsApp consent history; the latest row per phone + purpose wins.
model WhatsAppConsent {
  id         String        @id @default(cuid())
  customerId String?
  customer   Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  phone      String        @db.VarChar(20)
  purpose    String        @db.VarChar(30)
  status     ConsentStatus
  source     String        @db.VarChar(60)
  recordedAt DateTime      @default(now())

  @@index([phone, purpose, recordedAt])
}

// ─────────────────────────── Media (Hostinger disk + MySQL) ───────────────────────────

enum MediaKind {
  /// main packshot on a product card / page
  PRODUCT_IMAGE
  /// one of the four gallery slides
  GALLERY_SLIDE
  /// customer story photo
  REVIEW_PHOTO
  /// customer story video
  REVIEW_VIDEO
  /// still shown before a video plays
  POSTER
  /// image used by the website content screens (promo banner, about)
  CONTENT_IMAGE
}

enum MediaStatus {
  /// on disk and usable
  ACTIVE
  /// no longer shown; the file is kept until an admin purges it
  ARCHIVED
}

/// Every uploaded file. The bytes live under MEDIA_ROOT on the Hostinger server; this row is the
/// only thing that decides who may see them, so nothing is served straight from the folder.
model MediaAsset {
  id           String      @id @default(cuid())
  kind         MediaKind
  /// path relative to MEDIA_ROOT — generated by the server, never taken from the upload
  storageKey   String      @unique @db.VarChar(255)
  /// what the file was called on the uploader's computer (for the admin list only)
  originalName String      @db.VarChar(200)
  mime         String      @db.VarChar(80)
  bytes        Int
  /// SHA-256 of the stored bytes — detects a file that no longer matches its row
  checksum     String      @db.Char(64)
  width        Int?
  height       Int?
  /// seconds, for video
  durationSec  Decimal?    @db.Decimal(8, 2)
  alt          String?     @db.VarChar(300)
  status       MediaStatus @default(ACTIVE)
  /// derived copies (webp / thumbnail) as { webp?: key, thumb?: key }
  variants     Json?
  productId    String?     @db.VarChar(64)
  product      Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  reviewId     String?
  review       Review?     @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  /// who uploaded it (admin) — audit trail
  uploadedBy   String?     @db.VarChar(30)
  position     Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  archivedAt   DateTime?

  @@index([productId, status, position])
  @@index([reviewId, status])
  @@index([status, kind])
}

// ─────────────────────────── Content & settings ───────────────────────────

model SiteContent {
  key         String   @id @db.VarChar(100)
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Non-secret store settings only. Integration secrets live in server environment variables.
model StoreSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt
}

model AdminActivityLog {
  id         BigInt   @id @default(autoincrement())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(60)
  entityType String   @db.VarChar(40)
  entityId   String?  @db.VarChar(64)
  summary    String   @db.VarChar(500)
  meta       Json?
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId])
}

// ─────────────────────────── WhatsApp Business Cloud API (Phase 4) ───────────────────────────

enum WaDirection {
  OUTBOUND
  INBOUND
}

enum WaMessageState {
  /// waiting in the database queue (sent by the worker, survives restarts)
  QUEUED
  /// Meta accepted the request and returned a message id
  ACCEPTED
  SENT
  DELIVERED
  READ
  FAILED
  /// deliberately not sent (no consent, opted out, campaign cancelled, limit reached)
  SKIPPED
  /// a message the customer sent to the business
  RECEIVED
}

/// Every WhatsApp message in and out. dedupeKey is unique per business event (order + step, cart,
/// campaign + number, reply-to message), so retries and repeated status changes never send twice.
/// OTP codes are never stored here.
model WhatsAppMessage {
  id            String         @id @default(cuid())
  direction     WaDirection
  /// otp | order | cart | campaign | chatbot | support | test | inbound
  kind          String         @db.VarChar(20)
  /// which template purpose (order_shipped, abandoned_cart …) or null for free-form text
  purpose       String?        @db.VarChar(40)
  dedupeKey     String?        @unique @db.VarChar(191)
  waMessageId   String?        @unique @db.VarChar(191)
  /// E.164 digits without "+", e.g. 919876543210
  phone         String         @db.VarChar(20)
  customerId    String?        @db.VarChar(30)
  orderId       String?        @db.VarChar(30)
  campaignId    String?        @db.VarChar(30)
  templateName  String?        @db.VarChar(100)
  language      String?        @db.VarChar(15)
  /// template variables, in order
  params        Json?
  /// free-form text (chatbot / staff reply) or the customer's message, truncated
  body          String?        @db.Text
  state         WaMessageState
  attempts      Int            @default(0)
  nextAttemptAt DateTime?
  errorCode     Int?
  errorTitle    String?        @db.VarChar(300)
  errors        Json?
  acceptedAt    DateTime?
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  failedAt      DateTime?
  /// inbound message the chatbot handed to a person
  needsHuman    Boolean        @default(false)
  handledAt     DateTime?
  handledById   String?        @db.VarChar(30)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([state, nextAttemptAt])
  @@index([kind, createdAt])
  @@index([phone, createdAt])
  @@index([orderId])
  @@index([campaignId, state])
  @@index([direction, needsHuman, handledAt])
}

/// Durable inbox of signed webhook deliveries from Meta. One row per change item (message, status,
/// template update …); dedupeKey is unique so a retried delivery is stored and applied once.
model WhatsAppWebhookEvent {
  id              String    @id @default(cuid())
  dedupeKey       String    @unique @db.VarChar(191)
  /// messages.message | messages.status | messages.error | message_template_status_update | account_update …
  field           String    @db.VarChar(60)
  payload         Json
  receivedAt      DateTime  @default(now())
  attempts        Int       @default(0)
  nextAttemptAt   DateTime  @default(now())
  processedAt     DateTime?
  /// applied | ignored | unmatched | failed
  outcome         String?   @db.VarChar(30)
  processingError String?   @db.VarChar(500)

  @@index([processedAt, nextAttemptAt])
  @@index([receivedAt])
}

/// WhatsApp sign-in codes: only an HMAC of the code is stored; single use; 5-minute life.
model WhatsAppOtp {
  id          String    @id @default(cuid())
  phone       String    @db.VarChar(20)
  codeHash    String    @db.Char(64)
  expiresAt   DateTime
  attempts    Int       @default(0)
  consumedAt  DateTime?
  /// set after too many wrong codes; blocks new codes and checks for this number until then
  lockedUntil DateTime?
  messageId   String?   @db.VarChar(30)
  ip          String?   @db.VarChar(64)
  createdAt   DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([ip, createdAt])
}

enum CartRecoveryStatus {
  OPEN
  CONVERTED
  REMINDED
  SKIPPED
  EXPIRED
}

/// A checkout the shopper started (with consent to a reminder) but hasn't finished.
/// Only the server decides when it is "abandoned" (six hours after the last activity).
model AbandonedCheckout {
  id             String             @id @default(cuid())
  checkoutKey    String             @unique @db.VarChar(64)
  /// SHA-256 of the bag-recovery token; the token itself exists only in the WhatsApp link
  recoveryHash   String?            @unique @db.Char(64)
  customerId     String?            @db.VarChar(30)
  name           String             @db.VarChar(120)
  /// E.164 digits without "+"
  phone          String             @db.VarChar(20)
  /// [{ productId, variantId, quantity }] — product ids only, never prices from the browser
  lines          Json
  subtotalPaise  Int
  status         CartRecoveryStatus @default(OPEN)
  lastActivityAt DateTime           @default(now())
  remindAt       DateTime
  orderId        String?            @db.VarChar(30)
  messageId      String?            @db.VarChar(30)
  skipReason     String?            @db.VarChar(200)
  remindedAt     DateTime?
  recoveredAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status, remindAt])
  @@index([phone])
}

enum CampaignStatus {
  DRAFT
  /// approved by a permitted admin: recipients are queued for the scheduled time
  APPROVED
  COMPLETED
  CANCELLED
}

model WhatsAppCampaign {
  id             String         @id @default(cuid())
  name           String         @db.VarChar(120)
  templateName   String         @db.VarChar(100)
  language       String         @db.VarChar(15)
  /// { kind: "all_opted_in" | "has_ordered" | "no_order_days" | "bought_category", days?, category? }
  segment        Json
  /// template variable values; "{name}" and "{store_url}" are filled per customer
  params         Json
  status         CampaignStatus @default(DRAFT)
  scheduledAt    DateTime?
  maxRecipients  Int
  recipientCount Int?
  createdById    String?        @db.VarChar(30)
  approvedById   String?        @db.VarChar(30)
  approvedAt     DateTime?
  cancelledAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, scheduledAt])
}

/// Errors Meta returned to the server (code + plain reason). Never holds a token.
model WhatsAppApiError {
  id         BigInt   @id @default(autoincrement())
  operation  String   @db.VarChar(60)
  httpStatus Int?
  code       Int?
  subcode    Int?
  title      String   @db.VarChar(300)
  detail     String?  @db.VarChar(500)
  traceId    String?  @db.VarChar(80)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// A short lease so only one server process runs the background jobs at a time.
model JobLease {
  name       String   @id @db.VarChar(60)
  owner      String   @db.VarChar(80)
  leaseUntil DateTime
}
