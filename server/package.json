{
  "name": "being-you-always-api",
  "version": "1.0.0",
  "private": true,
  "description": "Being You – Always production API (Express + Prisma + MySQL) for Hostinger Node.js hosting.",
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:prod": "node dist/scripts/seed.js",
    "admin:create": "node dist/scripts/create-admin.js",
    "admin:reset-password": "node dist/scripts/reset-admin-password.js",
    "admin:create:dev": "tsx scripts/create-admin.ts",
    "test": "vitest run tests/unit",
    "test:db": "vitest run tests/integration --no-file-parallelism"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "argon2": "^0.41.1",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.6.1",
    "prisma": "^6.19.3",
    "razorpay": "^2.9.8",
    "sharp": "^0.33.5",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
