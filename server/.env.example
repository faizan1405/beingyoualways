# Being You – Always API — copy to .env (never commit the real file) or set these in
# Hostinger hPanel → Websites → Node.js app → Environment variables.

NODE_ENV=production
# Hostinger assigns the port for Node.js apps; keep PORT if your plan asks you to set it.
PORT=4000

# Hostinger MySQL database (hPanel → Databases → MySQL). URL-encode special characters in the password.
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME"

# Comma-separated website origins allowed to call the API with cookies (no trailing slash).
CORS_ORIGINS="https://beingyoualways.com,https://www.beingyoualways.com"

# Admin session cookie. Leave COOKIE_DOMAIN empty when the API is served from the same host as the website;
# use ".beingyoualways.com" when the API lives on a subdomain such as api.beingyoualways.com.
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# Sign-in protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Number of proxies in front of Node (Hostinger's web server = 1). Needed for correct client IPs and secure cookies.
TRUST_PROXY=1
LOG_LEVEL=info

# Private order-status links (/order/<number>#t=…). 32+ random characters; required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ORDER_LINK_SECRET=

# Razorpay — start with TEST keys (rzp_test_…). Live keys (rzp_live_…) are refused unless NODE_ENV=production.
# Leave empty to keep online payment switched off (Cash on Delivery can still be used if enabled in admin).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Minutes an unpaid online order holds its stock before it is released (5–120).
PAYMENT_HOLD_MINUTES=30
# true on a staging copy: every order is flagged as a test order and excluded from sales figures.
STORE_TEST_MODE=false

# ── Phase 3: shopper accounts ──
# Where links in account emails (confirm email, reset password) and the Google return trip point.
PUBLIC_SITE_URL=https://beingyoualways.com

# Sign in with Google — set all three or none (half-set values stop the server with a clear message).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (type "Web application").
# Authorised redirect URI must be exactly GOOGLE_REDIRECT_URL (https in production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://api.beingyoualways.com/api/auth/google/callback

# Account emails. "outbox" writes each message to MEDIA_ROOT/outbox instead of sending it (nothing is
# reported as sent). Switch to "smtp" once the mailbox exists (Hostinger Email: smtp.hostinger.com, port 465).
MAIL_TRANSPORT=outbox
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Being You – Always <no-reply@beingyoualways.com>"

# ── Phase 3: media (files on the server disk, details in MySQL) ──
# A folder outside the app's build output that survives redeploys; include it in backups.
MEDIA_ROOT=./media
MEDIA_MAX_IMAGE_BYTES=8388608
MEDIA_MAX_VIDEO_BYTES=83886080

# ── Later phases (leave empty until each integration is built and tested) ──
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
