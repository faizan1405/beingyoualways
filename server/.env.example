# Being You – Always API — copy to .env (never commit the real file) or set these in
# Hostinger hPanel → Websites → Node.js app → Environment variables.

NODE_ENV=production
# Which copy this is: "production" (the real store) or "staging" (the test copy — see .env.staging.example
# and docs/hostinger-staging.md). Required with NODE_ENV=production. The database and MEDIA_ROOT are
# stamped with it at the first start, and a server of the other kind then refuses to use them.
STORE_ENVIRONMENT=production
# Hostinger assigns the port for Node.js apps; keep PORT if your plan asks you to set it.
PORT=4000

# Hostinger MySQL database (hPanel → Databases → MySQL). URL-encode special characters in the password.
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME"

# Comma-separated website origins allowed to call the API with cookies (no trailing slash).
CORS_ORIGINS="https://beingyoualways.com,https://www.beingyoualways.com"

# Admin session cookie. Leave COOKIE_DOMAIN empty when the API is served from the same host as the website;
# use ".beingyoualways.com" when the API lives on a subdomain such as api.beingyoualways.com.
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# Sign-in protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Number of proxies in front of Node (Hostinger's web server = 1). Needed for correct client IPs and secure cookies.
TRUST_PROXY=1
LOG_LEVEL=info

# Private order-status links (/order/<number>#t=…). 32+ random characters; required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ORDER_LINK_SECRET=

# Razorpay — start with TEST keys (rzp_test_…). Live keys (rzp_live_…) are refused unless NODE_ENV=production.
# Leave empty to keep online payment switched off (Cash on Delivery can still be used if enabled in admin).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Minutes an unpaid online order holds its stock before it is released (5–120).
PAYMENT_HOLD_MINUTES=30
# true on a staging copy: every order is flagged as a test order and excluded from sales figures.
STORE_TEST_MODE=false

# ── Phase 3: shopper accounts ──
# The storefront address: links in account emails and the Google return trip point here.
# Must be https in production and one of CORS_ORIGINS.
PUBLIC_SITE_URL=https://beingyoualways.com

# Sign in with Google — set AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET and GOOGLE_REDIRECT_URL together, or none
# (half-set values stop the server with a clear message). Google Cloud Console → APIs & Services →
# Credentials → OAuth client ID (type "Web application"). The "Authorised redirect URI" there must be
# exactly GOOGLE_REDIRECT_URL. (GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are still read as older names.)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_REDIRECT_URL=https://api.beingyoualways.com/api/auth/google/callback
# Signs the 10-minute Google sign-in cookie. 32+ random characters; required in production when Google is on.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Account emails. "outbox" writes each message to MEDIA_ROOT/outbox instead of sending it (nothing is
# reported as sent). Switch to "smtp" once the mailbox exists (Hostinger Email: smtp.hostinger.com, port 465).
MAIL_TRANSPORT=outbox
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Being You – Always <no-reply@beingyoualways.com>"
# Staging only: the test inboxes (addresses or @domains, comma-separated) that may receive real email.
# MAIL_ALLOWED_RECIPIENTS=

# ── Phase 3: media (files on the server disk, details in MySQL) ──
# Absolute folder OUTSIDE the app's deploy folder, so GitHub redeploys never touch it (required in
# production — the server refuses to start otherwise). Include it in backups. Example for Hostinger:
MEDIA_ROOT=/home/YOUR_HOSTINGER_USER/bya-media
MEDIA_MAX_IMAGE_BYTES=8388608
MEDIA_MAX_VIDEO_BYTES=83886080

# ── Phase 4: WhatsApp Cloud API (Meta) ──
# All six core values together, or none (WhatsApp stays off and the admin says "not configured").
# Never put these in the website build, Git, or any VITE_ variable — the server is the only Meta caller.
# IDs (not secret) — from Meta App Dashboard / WhatsApp Manager:
WHATSAPP_APP_ID=1393915615725367
WHATSAPP_WABA_ID=1150649830611813
WHATSAPP_PHONE_NUMBER_ID=873369352531284
# Secrets — permanent System User access token (whatsapp_business_messaging + whatsapp_business_management),
# the app's App Secret (signs every webhook), and a random verify token you also paste into Meta's webhook form:
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v25.0
# Numbers (comma-separated, 10-digit or with 91) allowed to receive the admin "send a test message" check:
WHATSAPP_TEST_RECIPIENTS=
# Background sender (queue, retries, 6-hour reminders, campaigns). Leave unset; set false only on an extra instance.
# WHATSAPP_WORKER=true
