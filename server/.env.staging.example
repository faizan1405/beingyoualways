# Being You – Always API — STAGING copy (test store). Set these in hPanel → the staging Node.js app →
# Environment variables. Names only: never put real values in Git. Full guide: docs/hostinger-staging.md

NODE_ENV=production
STORE_ENVIRONMENT=staging
# Staging forces test orders; this line only documents it (false is refused).
STORE_TEST_MODE=true
PORT=4000

# A SEPARATE database created only for staging (never the live one — the server refuses a database
# stamped "production"). Start it empty; run migrations + seed.
DATABASE_URL="mysql://STAGING_DB_USER:STAGING_DB_PASSWORD@DB_HOST:3306/STAGING_DB_NAME"

# The staging website only.
CORS_ORIGINS="https://staging.beingyoualways.com"
PUBLIC_SITE_URL=https://staging.beingyoualways.com
# Leave COOKIE_DOMAIN empty (host-only cookies on the staging API). Cookie names default to
# bya_staging_admin_session / bya_staging_customer_session — the live names are refused.
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
TRUST_PROXY=1
LOG_LEVEL=info

# Its own random values (never copy the live ones). Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ORDER_LINK_SECRET=
AUTH_SECRET=

# Its own folder, outside the deploy folder and separate from the live MEDIA_ROOT.
MEDIA_ROOT=/home/YOUR_HOSTINGER_USER/bya-media-staging

# Razorpay TEST keys only (rzp_test_…); live keys are refused on staging.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google: a separate OAuth client (or the same client with this extra redirect URI added).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_REDIRECT_URL=https://api-staging.beingyoualways.com/api/auth/google/callback

# Email: real mail goes ONLY to these test inboxes; every other message stays in MEDIA_ROOT/outbox.
MAIL_TRANSPORT=outbox
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Being You – Always (staging) <no-reply@beingyoualways.com>"
MAIL_ALLOWED_RECIPIENTS=

# WhatsApp: staging messages ONLY the numbers in WHATSAPP_TEST_RECIPIENTS (required with WhatsApp on).
# Meta allows one webhook address per app: while staging tests WhatsApp, the app's webhook points here.
WHATSAPP_APP_ID=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_TEST_RECIPIENTS=
